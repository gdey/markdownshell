{
  "//": "For type checking only (tsc --noEmit); cmd/mdsh-gui/internal/build bundles with esbuild.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "/wails/runtime.js": ["vendor/types/@wailsio/runtime"],
      "*": ["vendor/types/*"]
    }
  },
  "include": ["src"]
}
